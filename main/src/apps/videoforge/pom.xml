<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>videoforge</groupId>
    <artifactId>videoforge-studio</artifactId>
    <version>1.0.0</version>
    <packaging>jar</packaging>
    <name>VideoForge Studio</name>
    <description>Open-source desktop YouTube video editor and screen recorder written in Java.</description>

    <properties>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <maven.compiler.release>21</maven.compiler.release>
        <javafx.version>26.0.2</javafx.version>
        <json.version>20240303</json.version>
        <main.class>videoforge.app.Main</main.class>
    </properties>

    <dependencies>
        <dependency>
            <groupId>org.openjfx</groupId>
            <artifactId>javafx-controls</artifactId>
            <version>${javafx.version}</version>
        </dependency>
        <dependency>
            <groupId>org.openjfx</groupId>
            <artifactId>javafx-swing</artifactId>
            <version>${javafx.version}</version>
        </dependency>
        <dependency>
            <groupId>org.json</groupId>
            <artifactId>json</artifactId>
            <version>${json.version}</version>
        </dependency>
    </dependencies>

    <build>
        <finalName>videoforge-studio</finalName>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>3.13.0</version>
            </plugin>

            <!--
              The exec plugin lets you run the app directly from the terminal:
                  mvn exec:java
              It adds the JavaFX module path automatically via the modulepath of the project.
            -->
            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>exec-maven-plugin</artifactId>
                <version>3.2.0</version>
                <configuration>
                    <mainClass>${main.class}</mainClass>
                </configuration>
            </plugin>

            <!--
              The shade plugin builds a single runnable fat jar, but JavaFX modules cannot be
              packed into an ordinary jar (they are native/platform-specific modules).
              The jlink plugin is therefore the correct packaging strategy:
                  mvn javafx:jlink
              produces build/videoforge-studio/ containing a native launcher.
            -->
            <plugin>
                <groupId>org.openjfx</groupId>
                <artifactId>javafx-maven-plugin</artifactId>
                <version>0.0.8</version>
                <configuration>
                    <mainClass>videoforge.app.Main</mainClass>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
