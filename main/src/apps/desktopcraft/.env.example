# Copy this file to .env and replace the example values.
# Your normal environment variables override values in .env.

DESKTOPCRAFT_FEEDBACK_TO=owner@example.com
DESKTOPCRAFT_SMTP_HOST=smtp.example.com
DESKTOPCRAFT_SMTP_PORT=587
DESKTOPCRAFT_SMTP_USER=owner@example.com
DESKTOPCRAFT_SMTP_PASSWORD=replace-with-an-app-password
DESKTOPCRAFT_SMTP_FROM=owner@example.com
DESKTOPCRAFT_SMTP_SECURITY=starttls

# Real Desktopcraft AI agent (server-side only; never put this key in browser code):
OPENAI_API_KEY=replace-with-your-openai-api-key
# Optional agent tuning:
OPENAI_HELPER_MODEL=gpt-5.6-sol
OPENAI_HELPER_REASONING=medium

# Optional overrides:
# DESKTOPCRAFT_FEEDBACK_FILE=/absolute/path/to/texta.txt
# HOST=127.0.0.1
# PORT=8000
