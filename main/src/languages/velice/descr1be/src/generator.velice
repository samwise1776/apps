# generator.velice — turn the project model into editable Velice source.
import model
import util

fn generate(project) {
    var out = []
    append(out, "# Generated by Descr1be — edit freely; Design mode re-parses this file.")
    append(out, "import gui")
    append(out, "")
    var window_name = _var_name(util.map_get(project, "name", "MyApp"))
    append(out, "window " + window_name + " {")
    append(out, "    title = " + _str(util.map_get(project, "name", "MyApp")))
    append(out, "    width = 800")
    append(out, "    height = 600")
    append(out, "")
    for root in project["widgets"] {
        _gen_widget(out, root, 1)
    }
    append(out, "}")
    append(out, "")
    append(out, "run " + window_name)
    return join(out, "\n")
}

fn _gen_widget(out, node, depth) {
    var indent = _pad(depth)
    append(out, indent + _dsl_type(node["type"]) + " " + _var_name(node["name"]) + " {")
    _emit_int(out, "x", node["x"], depth)
    _emit_int(out, "y", node["y"], depth)
    _emit_int(out, "width", node["w"], depth)
    _emit_int(out, "height", node["h"], depth)
    for k in keys(node["props"]) {
        _emit_prop(out, k, node["props"][k], depth)
    }
    for ev in keys(node["events"]) {
        _emit_event(out, ev, node["events"][ev], depth)
    }
    for child in node["children"] {
        _gen_widget(out, child, depth + 1)
    }
    append(out, indent + "}")
}

fn _emit_int(out, key, value, depth) {
    append(out, _pad(depth + 1) + key + " = " + str(int(value)))
}

fn _emit_prop(out, key, value, depth) {
    var indent = _pad(depth + 1)
    var vtype = typeof(value)
    if vtype == "string" {
        append(out, indent + key + " = " + _str(value))
    } elif vtype == "bool" {
        if value {
            append(out, indent + key + " = true")
        } else {
            append(out, indent + key + " = false")
        }
    } elif vtype == "int" or vtype == "float" {
        append(out, indent + key + " = " + str(value))
    } else {
        append(out, indent + key + " = " + json_stringify(value))
    }
}

fn _emit_event(out, ev, code, depth) {
    var indent = _pad(depth + 1)
    if trim(str(code)) == "" {
        append(out, indent + ev + " {}")
        return
    }
    var body_indent = _pad(depth + 2)
    var lines = split(str(code), "\n")
    var body = join(lines, "\n" + body_indent)
    append(out, indent + ev + " {")
    append(out, body_indent + body)
    append(out, indent + "}")
}

fn _str(s) {
    var out = replace(str(s), "\\", "\\\\")
    out = replace(out, "\"", "\\\"")
    out = replace(out, "\n", "\\n")
    out = replace(out, "\r", "\\r")
    return "\"" + out + "\""
}

fn _pad(n) {
    var s = ""
    var i = 0
    while i < n {
        s = s + "    "
        i = i + 1
    }
    return s
}

fn _var_name(name) {
    var s = replace(str(name), " ", "_")
    s = replace(s, "-", "_")
    s = replace(s, ".", "_")
    return s
}

fn _dsl_type(wtype) {
    if wtype == "password" { return "passwordfield" }
    if wtype == "radio" { return "radiobutton" }
    return wtype
}
