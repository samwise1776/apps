# Error handling with try/catch/finally
fn risky(n) {
    if n < 0 {
        throw "negative number not allowed"
    }
    if n == 0 {
        throw "zero not allowed"
    }
    return 100 / n
}

try {
    print("result:", risky(10))
} catch e {
    print("caught:", e)
}

try {
    print("result:", risky(-1))
} catch e {
    print("caught:", e)
}

# finally always runs
try {
    print("inside try")
    throw "boom"
} catch e {
    print("caught:", e)
} finally {
    print("cleanup done")
}

# nil coalescing for safe defaults
let maybe = nil
print("fallback:", maybe ?? "default value")
let value = 5
print("direct:", value ?? "default value")
