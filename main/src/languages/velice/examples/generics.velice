# Generic-style patterns with higher-order functions
fn identity(x) {
    return x
}

fn apply_twice(f, x) {
    return f(f(x))
}

fn increment(x) { return x + 1 }
fn square(x) { return x * x }

print("apply twice increment:", apply_twice(increment, 5))
print("apply twice square:", apply_twice(square, 3))

# Generic-ish collection helpers
fn make_pair(a, b) {
    return [a, b]
}

let pair = make_pair("left", 42)
print("pair:", pair)
print("pair[0]:", pair[0])
print("pair[1]:", pair[1])
