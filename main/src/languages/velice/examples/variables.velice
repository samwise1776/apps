# Variables and types
let name = "Velice"        # immutable by default
let mut count = 0          # mut makes it reassignable
const MAX_USERS = 1000     # compile-time constant

count = count + 1
print("name:", name)
print("count:", count)
print("max:", MAX_USERS)

let price = 19.99          # float
let is_ready = true        # bool
let nothing = nil          # nil

print(price, is_ready, nothing)

# `var` is shorthand for a mutable binding
var v = 10
v = v + 5
print("var:", v)

# Variable code: `var f = (expr)` stores deferred code, run on `f()`
var greet = (print("hello from a thunk"))
greet()
var f = (6 * 7)
print("thunk:", f())
